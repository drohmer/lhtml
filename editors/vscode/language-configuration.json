{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] },
    { "open": "<!--", "close": " -->", "notIn": ["comment", "string"] },
    { "open": "{%", "close": " %}" },
    { "open": "{{", "close": " }}" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"],
    ["\"", "\""],
    ["`", "`"],
    ["*", "*"],
    ["_", "_"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:(?!(?:link|img|video|videoplay|gap)::|code::\\[-\\])[A-Za-z][\\w-]*::(?=[\\s(\\[{]|$)|::(?=[\\[\\({]))(?!.*::\\s*$).*$|^\\s*<!--\\s*#region\\b",
      "end": "^\\s*(?:::|code::\\[-\\])\\s*$|^\\s*<!--\\s*#endregion\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\$\\%\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
